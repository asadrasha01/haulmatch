# ==============================================================================
# HaulMatch AI — Backend, Auth & Storage Environment Variables
# ==============================================================================
# STAGE 1 (Current): $0 Free Tier
# - Works out-of-the-box with zero env vars using Resilient Local Storage Mode,
#   browser-native Tesseract.js WASM OCR, and Web Speech API fluency scoring.
# - Or connect a Free Tier Supabase project (https://supabase.com — $0/mo):
# ==============================================================================

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ==============================================================================
# STAGE 2 (Post-Deployment Scale): Hetzner, Cloudflare R2, Twilio & Google OAuth
# ==============================================================================

# 1. Hetzner Self-Hosted Supabase / PostgreSQL (Coolify or Docker Compose)
#    Point VITE_SUPABASE_URL above to your Hetzner instance (e.g. https://api.haulmatch.ai)

# 2. Google Account OAuth (Enabled in Supabase Dashboard -> Authentication -> Providers -> Google)
#    Uses `signInWithGoogle()` in src/services/supabase.ts automatically once connected.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# 3. Cloudflare R2 / S3 Direct Video Upload ($0 egress fee video storage)
# VITE_S3_PRESIGNED_UPLOAD_URL=https://<account_id>.r2.cloudflarestorage.com/haulmatch-driver-media
# S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=your_r2_access_key
# S3_SECRET_ACCESS_KEY=your_r2_secret_key
# S3_BUCKET_NAME=haulmatch-driver-media

# 4. Twilio SMS Integration (for automated 14-day driver retention pulse checks)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_PHONE_NUMBER=+18005550199
